# Weights: 5 GB, fetched by scripts/fetch_weights.py
weights/*.safetensors
weights/*.pt

# KITTI imagery and labels: fetched by scripts/fetch_kitti.py
data/2011_09_26/
data/demo_frames/
data/demo_seq/
data/*.zip

# Cached VGGT geometry: regenerated by scripts/cache_geometry.py
cache/

# Run outputs: regenerated by scripts/reproduce_all.sh
outputs/

__pycache__/
*.pyc
.venv/
.DS_Store
.tools/

# KittiMoSeg: archives fetched via gdown, labels extracted from them
data/kittimoseg/
data/moseg/

# Belt and braces: NO data file is ever committed. Everything under data/ is
# fetched by scripts/fetch_kitti.py and scripts/fetch_moseg.py. Twelve .7z
# archives (437 MB largest) were tracked here once and had to be purged from
# history; these rules stop that recurring.
data/
*.7z
*.7z.*
*.part
*.zip
*.safetensors
*.pt
*.npz
